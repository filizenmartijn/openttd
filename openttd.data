/* Emulate old GSText parameter padding behaviour */
GSText.SCRIPT_TEXT_MAX_PARAMETERS <- 20;

class GSCompat14 {
	function Text(text)
	{
		if (typeof text == "string") return text;
		if (typeof text == "instance" && text instanceof GSText) return text;
		return null;
	}
}

